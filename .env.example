# Shasta testnet. Nile: https://nile.trongrid.io  Mainnet: https://api.trongrid.io
TRON_FULL_HOST=https://api.shasta.trongrid.io

# Optional TronGrid key, sent as the TRON-PRO-API-KEY header. Never commit a real key.
TRON_API_KEY=

# 64-character hex signing key. Required only for transfer. Leave empty for balance reads.
# Mutually exclusive with TRON_DEFAULT_ADDRESS. Never commit a real key.
TRON_PRIVATE_KEY=

# Base58 address set on the client when TRON_PRIVATE_KEY is empty.
# Balance reads also pass the queried owner as the constant-call caller, so this can stay empty.
TRON_DEFAULT_ADDRESS=

# TRC-20 contract (base58) on the same network as TRON_FULL_HOST.
TRC20_CONTRACT=

# Account whose TRC-20 balance the demo reads.
TRON_OWNER_ADDRESS=

# Broadcast a transfer only when this is exactly "true".
# Also requires TRON_PRIVATE_KEY, TRON_TRANSFER_TO, and TRON_TRANSFER_AMOUNT.
TRON_DEMO_TRANSFER=false
TRON_TRANSFER_TO=

# Integer amount in smallest token units (respect the token decimals). Not a decimal amount.
TRON_TRANSFER_AMOUNT=
